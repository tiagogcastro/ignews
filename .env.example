# Database (SQLite through Prisma)
DATABASE_URL="file:./dev.db"

# Auth: GitHub OAuth app credentials
# Callback URL for local development: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing key used by next-auth (generate with: openssl rand -base64 32)
SIGNING_KEY=

# Development-only email login for local testing. Never enable in production.
AUTH_DEV_LOGIN=false

# Stripe test keys and recurring price id of the ig.news plan
STRIPE_SECRET_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/posts
STRIPE_CANCEL_URL=http://localhost:3000

# Integration providers. Leave empty to auto-detect:
# PAYMENT_PROVIDER falls back to stripe when STRIPE_SECRET_API_KEY exists, sandbox otherwise
# CMS_PROVIDER falls back to prismic when PRISMIC_ENDPOINT exists, sandbox otherwise
PAYMENT_PROVIDER=
CMS_PROVIDER=

# Prismic CMS
PRISMIC_ENDPOINT=
PRISMIC_ACCESS_TOKEN=
